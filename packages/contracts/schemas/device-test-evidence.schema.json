{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contribution:schema:device-test-evidence:v1",
  "title": "Contribution remote physical acceptance evidence record v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordMode": {
      "enum": [
        "observed",
        "fixture"
      ]
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceId": {
      "type": "string",
      "pattern": "^AT-(?:0[1-9]|1[0-9]|2[0-4])$"
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RDEV-(?:0[1-9]|[1-3][0-9]|40)$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "operation": {
      "enum": [
        "connect",
        "prepare",
        "install",
        "launch",
        "logs",
        "test",
        "ui",
        "debug",
        "screenshot",
        "screen_capture",
        "native_xcode_destination"
      ]
    },
    "context": {
      "$ref": "urn:contribution:schema:device-capability:v1#/$defs/context"
    },
    "evidenceKind": {
      "enum": [
        "physical_device",
        "fixture"
      ]
    },
    "executionStatus": {
      "enum": [
        "not_run",
        "executed"
      ]
    },
    "outcome": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "plannedSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coldStartProof": {
      "type": "object",
      "properties": {
        "priorDeveloperSessionAbsent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "usableWifiAbsent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "usbAbsent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "phoneCellularConfirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "restartKind": {
          "enum": [
            "none",
            "phone",
            "host",
            "both",
            "not_tested"
          ]
        }
      },
      "required": [
        "priorDeveloperSessionAbsent",
        "usableWifiAbsent",
        "usbAbsent",
        "phoneCellularConfirmed",
        "restartKind"
      ],
      "additionalProperties": false
    },
    "dataRetention": {
      "enum": [
        "not_tested",
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missingProof": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "recordMode",
    "evidenceId",
    "acceptanceId",
    "requirementIds",
    "operation",
    "context",
    "evidenceKind",
    "executionStatus",
    "outcome",
    "startedAt",
    "completedAt",
    "plannedSteps",
    "observations",
    "operationIds",
    "evidenceRefs",
    "coldStartProof",
    "dataRetention",
    "claims",
    "missingProof"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "recordMode": {
            "const": "observed"
          },
          "evidenceKind": {
            "const": "physical_device"
          },
          "executionStatus": {
            "const": "executed"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "missingProof": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "not_run"
          }
        }
      },
      "then": {
        "properties": {
          "executionStatus": {
            "const": "not_run"
          },
          "startedAt": {
            "type": "null"
          },
          "completedAt": {
            "type": "null"
          },
          "claims": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acceptanceId": {
            "enum": [
              "AT-08",
              "AT-09",
              "AT-10"
            ]
          },
          "outcome": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "coldStartProof": {
            "properties": {
              "priorDeveloperSessionAbsent": {
                "const": true
              },
              "usableWifiAbsent": {
                "const": true
              },
              "usbAbsent": {
                "const": true
              },
              "phoneCellularConfirmed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
