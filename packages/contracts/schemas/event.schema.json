{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contribution:schema:event:v1",
  "title": "Contribution durable event record v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "originHostId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "repositoryId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "originHostId",
    "sequence",
    "operationId",
    "repositoryId",
    "occurredAt",
    "type",
    "payload"
  ],
  "additionalProperties": true
}
