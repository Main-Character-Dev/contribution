{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contribution:schema:response:v1",
  "title": "Contribution response envelope v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestStatus": {
      "enum": [
        "completed",
        "accepted",
        "rejected"
      ]
    },
    "operationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "operationState": {
      "anyOf": [
        {
          "enum": [
            "queued_local",
            "queued",
            "waiting",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted",
            "outcome_unknown",
            "needs_attention"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "nextActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "label",
                  "argv"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "nextActions"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requestStatus",
    "operationId",
    "operationState",
    "result",
    "error"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "requestStatus": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "operationState": {
            "enum": [
              "queued_local",
              "queued",
              "waiting",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted",
              "outcome_unknown",
              "needs_attention"
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requestStatus": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "nextActions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "argv": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "argv"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "nextActions"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operationId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "operationState": {
            "type": "null"
          }
        }
      }
    }
  ]
}
