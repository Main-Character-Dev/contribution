{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contribution:schema:device-profile:v1",
  "title": "Contribution private project device profile v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repositoryId": {
      "type": "string",
      "format": "uuid"
    },
    "adapterId": {
      "const": "xcode-ios-v1"
    },
    "app": {
      "$ref": "urn:contribution:schema:artifact-provenance:v1#/properties/app"
    },
    "permitsForeground": {
      "type": "boolean"
    },
    "eligibleDeviceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^device-[A-Za-z0-9-]{1,128}$"
      }
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "containerKind": {
            "enum": [
              "project",
              "workspace"
            ]
          },
          "containerPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "scheme": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "configuration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "appName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.()-]{0,120}\\.app$"
          },
          "developerDirectory": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 2048
          },
          "xcodeVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "xcodeBuild": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "signingMode": {
            "enum": [
              "development",
              "ad_hoc"
            ]
          },
          "provisioningProfileSpecifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "containerKind",
          "containerPath",
          "scheme",
          "configuration",
          "appName",
          "developerDirectory",
          "xcodeVersion",
          "xcodeBuild",
          "signingMode",
          "provisioningProfileSpecifier",
          "timeoutSeconds"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "adapterId",
    "app",
    "permitsForeground",
    "eligibleDeviceRefs",
    "builds"
  ]
}
