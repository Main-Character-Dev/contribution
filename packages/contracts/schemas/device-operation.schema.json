{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contribution:schema:device-operation:v1",
  "title": "Contribution private retained device operation receipt v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordMode": {
      "enum": [
        "observed",
        "fixture"
      ]
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "repositoryId": {
      "type": "string",
      "format": "uuid"
    },
    "executionHostId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "connect",
            "prepare",
            "install",
            "install_and_launch",
            "launch",
            "logs",
            "test",
            "ui",
            "debug",
            "screenshot",
            "screen_capture",
            "disconnect",
            "transfer_host"
          ]
        },
        "app": {
          "type": "object",
          "properties": {
            "bundleId": {
              "type": "string",
              "minLength": 1
            },
            "teamId": {
              "type": "string",
              "pattern": "^[A-Z0-9]{10}$"
            },
            "applicationIdentifier": {
              "type": "string",
              "minLength": 1
            },
            "marketingVersion": {
              "type": "string",
              "minLength": 1
            },
            "buildVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "bundleId",
            "teamId",
            "applicationIdentifier",
            "marketingVersion",
            "buildVersion"
          ],
          "additionalProperties": false
        },
        "artifactRef": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "installedAppRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "configurationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1
        },
        "authorizedOperations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "routine",
            "qualification"
          ]
        },
        "qualification": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "acceptanceId": {
                  "type": "string",
                  "pattern": "^AT-(?:0[1-9]|1[0-9]|2[0-4])$"
                },
                "planId": {
                  "type": "string",
                  "minLength": 1
                },
                "fixtureId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedContextDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "authorizedOperations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxDurationSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "acceptanceId",
                "planId",
                "fixtureId",
                "expectedContextDigest",
                "authorizedOperations",
                "maxAttempts",
                "maxDurationSeconds"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "app",
        "artifactRef",
        "installedAppRef",
        "sourceCommit",
        "configurationId",
        "adapterId",
        "policyRevision",
        "authorizedOperations",
        "mode",
        "qualification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "routine"
              }
            }
          },
          "then": {
            "properties": {
              "qualification": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "qualification"
              }
            }
          },
          "then": {
            "properties": {
              "qualification": {
                "type": "object",
                "properties": {
                  "acceptanceId": {
                    "type": "string",
                    "pattern": "^AT-(?:0[1-9]|1[0-9]|2[0-4])$"
                  },
                  "planId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fixtureId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expectedContextDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "authorizedOperations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "maxAttempts": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxDurationSeconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "acceptanceId",
                  "planId",
                  "fixtureId",
                  "expectedContextDigest",
                  "authorizedOperations",
                  "maxAttempts",
                  "maxDurationSeconds"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "context": {
      "$ref": "urn:contribution:schema:device-capability:v1#/$defs/context"
    },
    "capabilityIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownershipId": {
      "type": "string",
      "format": "uuid"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "operationState": {
      "enum": [
        "queued_local",
        "queued",
        "waiting",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted",
        "outcome_unknown",
        "needs_attention"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "resultCertainty": {
      "enum": [
        "not_observed",
        "confirmed",
        "uncertain"
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effectId": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "prepare",
              "install",
              "launch",
              "logs",
              "test",
              "ui",
              "debug",
              "screenshot",
              "screen_capture",
              "connect",
              "disconnect",
              "transfer_host"
            ]
          },
          "state": {
            "enum": [
              "not_requested",
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "outcome_unknown",
              "needs_attention"
            ]
          },
          "certainty": {
            "enum": [
              "not_observed",
              "confirmed",
              "uncertain"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "installReadback": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bundleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "teamId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "marketingVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "buildVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "deviceId",
                  "bundleId",
                  "teamId",
                  "marketingVersion",
                  "buildVersion",
                  "observedAt",
                  "method"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "launchReadback": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bundleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "processState": {
                    "enum": [
                      "running",
                      "foreground",
                      "not_running",
                      "unknown"
                    ]
                  },
                  "processId": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "deviceId",
                  "bundleId",
                  "processState",
                  "processId",
                  "observedAt",
                  "method"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "uniqueItems": true
          },
          "missingProof": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "effectId",
          "operation",
          "state",
          "certainty",
          "startedAt",
          "completedAt",
          "installReadback",
          "launchReadback",
          "evidenceRefs",
          "reasonCodes",
          "missingProof"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "install"
                },
                "state": {
                  "const": "succeeded"
                }
              }
            },
            "then": {
              "properties": {
                "installReadback": {
                  "type": "object",
                  "properties": {
                    "deviceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bundleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "teamId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "marketingVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "buildVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "deviceId",
                    "bundleId",
                    "teamId",
                    "marketingVersion",
                    "buildVersion",
                    "observedAt",
                    "method"
                  ],
                  "additionalProperties": false
                },
                "certainty": {
                  "const": "confirmed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "outcome_unknown"
                }
              }
            },
            "then": {
              "properties": {
                "certainty": {
                  "const": "uncertain"
                },
                "missingProof": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "launch"
                },
                "state": {
                  "const": "succeeded"
                }
              }
            },
            "then": {
              "properties": {
                "launchReadback": {
                  "type": "object",
                  "properties": {
                    "deviceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bundleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "processState": {
                      "enum": [
                        "running",
                        "foreground"
                      ]
                    },
                    "processId": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "observedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "deviceId",
                    "bundleId",
                    "processState",
                    "processId",
                    "observedAt",
                    "method"
                  ],
                  "additionalProperties": false
                },
                "certainty": {
                  "const": "confirmed"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "reconciliation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_required",
            "required",
            "in_progress",
            "resolved",
            "blocked"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "lastObservedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "nextObservation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "status",
        "attempts",
        "lastObservedAt",
        "nextObservation"
      ],
      "additionalProperties": false
    },
    "logRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "missingProof": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "recordMode",
    "operationId",
    "requestId",
    "repositoryId",
    "executionHostId",
    "deviceId",
    "intent",
    "context",
    "capabilityIds",
    "ownershipId",
    "requestedAt",
    "startedAt",
    "completedAt",
    "operationState",
    "stage",
    "resultCertainty",
    "effects",
    "reconciliation",
    "logRefs",
    "reasonCodes",
    "missingProof"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operationState": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "resultCertainty": {
            "const": "uncertain"
          },
          "reconciliation": {
            "properties": {
              "status": {
                "enum": [
                  "required",
                  "in_progress",
                  "blocked"
                ]
              }
            }
          },
          "missingProof": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "properties": {
              "operation": {
                "enum": [
                  "install",
                  "install_and_launch"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "intent": {
            "properties": {
              "artifactRef": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "artifactId",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operationState": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "resultCertainty": {
            "const": "confirmed"
          },
          "effects": {
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "succeeded",
                    "not_requested"
                  ]
                },
                "certainty": {
                  "enum": [
                    "confirmed",
                    "not_observed"
                  ]
                }
              }
            }
          },
          "reconciliation": {
            "properties": {
              "status": {
                "enum": [
                  "not_required",
                  "resolved"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "properties": {
              "operation": {
                "const": "install_and_launch"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "effects": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "operation": {
                      "const": "install"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "operation": {
                      "const": "launch"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
